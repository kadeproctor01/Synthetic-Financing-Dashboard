import { describe, expect, it } from "vitest";
import { defaultModelConfiguration } from "@/domain/config";
import { buildFinancingMetrics } from "@/domain/calculations";
import { calculateBoxStructures } from "@/domain/engine";
import { MockMarketDataProvider } from "@/domain/mockMarketData";
import type { BoxRequest } from "@/domain/types";

const request: BoxRequest = {
  requestedNetProceedsUsd: 200000,
  desiredTenorMonths: 6,
  eligibleCollateralValueUsd: 2000000,
  tradeDate: "2026-08-07"
};

describe("box spread calculation engine", () => {
  it("matches the workbook-derived financing formulas for a known credit", () => {
    const result = buildFinancingMetrics({
      request,
      config: defaultModelConfiguration,
      lowerStrike: 7200,
      upperStrike: 7700,
      expirationDate: "2027-02-07",
      executedBoxCreditPerIndexPoint: 483.1
    });

    expect(result.issues).toEqual([]);
    expect(result.financing?.boxWidth).toBe(500);
    expect(result.financing?.faceValuePerContractUsd).toBe(50000);
    expect(result.financing?.contractCount).toBe(5);
    expect(result.financing?.grossBoxCreditUsd).toBeCloseTo(241550, 5);
    expect(result.financing?.transactionCostUsd).toBeCloseTo(13, 5);
    expect(result.financing?.netCreditReceivedUsd).toBeCloseTo(241537, 5);
    expect(result.financing?.maturityObligationUsd).toBeCloseTo(250000, 5);
    expect(result.financing?.allInFinancingCostUsd).toBeCloseTo(8463, 5);
    expect(result.financing?.effectiveAnnualRateDecimal).toBeGreaterThan(0);
  });

  it("generates whole-contract candidates and selects the lowest effective rate", async () => {
    const result = await calculateBoxStructures(request, defaultModelConfiguration, new MockMarketDataProvider());

    expect(result.candidates.length).toBeGreaterThan(0);
    expect(result.selectedCandidate).not.toBeNull();
    expect(result.selectedCandidate?.financing.contractCount).toBeGreaterThan(0);
    expect(Number.isInteger(result.selectedCandidate?.financing.contractCount)).toBe(true);
    expect(result.selectedCandidate?.financing.netCreditReceivedUsd).toBeGreaterThanOrEqual(request.requestedNetProceedsUsd);
  });

  it("fails closed when credit exceeds face value per index point", () => {
    const result = buildFinancingMetrics({
      request,
      config: defaultModelConfiguration,
      lowerStrike: 7200,
      upperStrike: 7700,
      expirationDate: "2027-02-07",
      executedBoxCreditPerIndexPoint: 500
    });

    expect(result.financing).toBeUndefined();
    expect(result.issues.some((issue) => issue.code === "CREDIT_ABOVE_FACE_VALUE")).toBe(true);
  });
});
